<?php
/**
 * Product post type bridge for a future WooCommerce or custom catalogue.
 *
 * @package LumiereDuMonde
 */

defined( 'ABSPATH' ) || exit;

function ldm_register_product_post_type() {
	$labels = array(
		'name' => __( 'Produits Lumière', 'lumiere-du-monde' ),
		'singular_name' => __( 'Produit Lumière', 'lumiere-du-monde' ),
		'add_new_item' => __( 'Ajouter un produit', 'lumiere-du-monde' ),
		'edit_item' => __( 'Modifier le produit', 'lumiere-du-monde' ),
	);
	register_post_type( 'ldm_product', array(
		'labels' => $labels,
		'public' => true,
		'show_in_rest' => true,
		'has_archive' => false,
		'rewrite' => array( 'slug' => 'produits' ),
		'menu_icon' => 'dashicons-admin-customizer',
		'supports' => array( 'title', 'editor', 'thumbnail', 'excerpt', 'custom-fields' ),
		'taxonomies' => array( 'category' ),
	) );
	foreach ( array( 'ldm_price', 'ldm_availability', 'ldm_category', 'ldm_whatsapp_url' ) as $meta_key ) {
		register_post_meta( 'ldm_product', $meta_key, array(
			'type' => 'string', 'single' => true, 'show_in_rest' => true,
			'sanitize_callback' => 'sanitize_text_field', 'auth_callback' => function() { return current_user_can( 'edit_posts' ); },
		) );
	}
}
add_action( 'init', 'ldm_register_product_post_type' );
