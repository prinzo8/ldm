function ldm_get_products( $universe = '' ) {
	$products = ldm_demo_products();
	if ( $universe ) {
		$products = array_values( array_filter( $products, function( $product ) use ( $universe ) {
			return $product['universe'] === $universe;
		} ) );
	}
	return $products;
}

function ldm_get_product_image_url( $product ) {
	return trailingslashit( get_template_directory_uri() ) . 'assets/images/products/' . rawurlencode( $product['image'] );
}
